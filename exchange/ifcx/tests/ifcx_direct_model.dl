# SPDX-License-Identifier: MPL-2.0
# The direct IfcX construction (#161, step 3) builds the same model as the
# text route: one level, a wall type with two layers, and a wall carrying a
# base offset and a top level. The two routes are compared field by field,
# not byte for byte.
import bim/bim_index.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl
import exchange/ifcx/bim_ifcx_model.dl

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, (the string form of "Brick"), 0.1)) to layers
append (@intrinsic("construct", a bim layer record, (the string form of "Insulation"), 0.05)) to layers
set wallType to add bim wall type named (the string form of "Baksteen") with layers to target
set wall to add bim wall typed wallType on storey from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
set wallRecord to the item at 0 in (modelValue's walls's values)
replace item at index 0 in (modelValue's walls's values) with (@intrinsic("construct", a bim wall record, wallRecord's id, wallRecord's typeId, wallRecord's levelId, wallRecord's start, wallRecord's finish, wallRecord's height, wallRecord's bulge, wallRecord's lean, wallRecord's rise, 0.25, storey))

# The next group of kinds: a slab, a plate of the wall type, an opening type
# with its opening, and a grid line.
set outline to an empty list of a cad vector2
append (a cad vector2 with x -1.0 and y -1.0) to outline
append (a cad vector2 with x 5.0 and y -1.0) to outline
append (a cad vector2 with x 5.0 and y 3.0) to outline
append (a cad vector2 with x -1.0 and y 3.0) to outline
ignore add bim slab on storey around outline thick 0.2 to target
free outline
set plateOutline to a cad topology list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to (plateOutline's values)
append (a cad vector2 with x 3.0 and y 0.0) to (plateOutline's values)
append (a cad vector2 with x 3.0 and y 2.0) to (plateOutline's values)
set plateId to the bim new id in target
append (@intrinsic("construct", a bim slab record, plateId, storey, plateOutline, 0.15, (the string form of "concrete"), wallType, 0.5, 0.0, 0.0)) to (modelValue's slabs's values)
set windowType to add bim opening type named (the string form of "Raam 900x1200") sized 0.9 by 1.2 with sill 0.9 and frame 0.05 to target
ignore add bim opening typed windowType in wallRecord's id at 1.5 to target
ignore add bim grid named (the string form of "A") from (a cad vector2 with x -1.0 and y -1.0) to (a cad vector2 with x -1.0 and y 4.0) reaching -1.0 to 4.0 to target

# The next group of kinds: two dimensions (one placed, one on paper in a view),
# a line, a face and a text, and a component of two parts.
set firstEnd to @intrinsic("construct", a bim reference record, wallRecord's id, bim wall start feature)
set secondEnd to @intrinsic("construct", a bim reference record, wallRecord's id, bim wall finish feature)
ignore add bim dimension from firstEnd to secondEnd through (a cad vector2 with x 0.0 and y 1.5) to target
ignore add bim dimension from firstEnd to secondEnd in view (42 as a 64 bit integer) through (a cad vector2 with x 0.0 and y 2.0) outward (a cad vector2 with x 0.0 and y 1.0) at 250.0 paper millimetres to target
ignore add bim line on storey from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 2.0 and y 4.0) to target
set faceOutline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to faceOutline
append (a cad vector2 with x 2.0 and y 0.0) to faceOutline
append (a cad vector2 with x 2.0 and y 2.0) to faceOutline
append (a cad vector2 with x 0.0 and y 2.0) to faceOutline
ignore add bim face on storey around faceOutline to target
free faceOutline
ignore add bim text on storey at (a cad vector2 with x 1.0 and y 5.0) saying (the string form of "Label") to target
set partFaceId to the bim new id in target
set partLineId to the bim new id in target
set parts to an empty list of a bim sketch record
set partOutline to a cad topology list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to (partOutline's values)
append (a cad vector2 with x 0.5 and y 0.0) to (partOutline's values)
append (a cad vector2 with x 0.5 and y 0.5) to (partOutline's values)
append (a cad vector2 with x 0.0 and y 0.5) to (partOutline's values)
append (@intrinsic("construct", a bim sketch record, partFaceId, 0 as a 64 bit integer, bim face sketch, partOutline, 0.05, (the string form of ""))) to parts
set partLine to a cad topology list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to (partLine's values)
append (a cad vector2 with x 0.5 and y 0.5) to (partLine's values)
append (@intrinsic("construct", a bim sketch record, partLineId, 0 as a 64 bit integer, bim line sketch, partLine, 0.0, (the string form of ""))) to parts
set componentId to add bim component named (the string form of "Frame") to target
ignore set bim component componentId contents to parts in target
free parts

set exportText to the bim ifcx text of modelValue identified as (the string form of "m.ifcx") for project (the string form of "m") by (the string form of "test") at (the string form of "2026-11-18T00:00:00Z")
set native to the bim native text of ifcx exportText
set fromText to the bim model parsed from native's text
set fromDirect to the bim ifcx model of exportText

print ((the string form of "text route: ") + ((the string form of fromText's valid) + ((the string form of " ") + fromText's message))) as a line
print ((the string form of "direct route: ") + ((the string form of fromDirect's valid) + ((the string form of " ") + fromDirect's message))) as a line

set textModel to fromText's modelValue
set directModel to fromDirect's modelValue
set textLevel to the item at 0 in (textModel's levels's values)
set directLevel to the item at 0 in (directModel's levels's values)
print ((the string form of "text levels: ") + (the string form of (the length of (textModel's levels's values)))) as a line
print ((the string form of "direct levels: ") + (the string form of (the length of (directModel's levels's values)))) as a line
print ((the string form of "text level name: ") + textLevel's name) as a line
print ((the string form of "direct level name: ") + directLevel's name) as a line
print ((the string form of "text level elevation: ") + (the string form of textLevel's elevation)) as a line
print ((the string form of "direct level elevation: ") + (the string form of directLevel's elevation)) as a line
print ((the string form of "text level height: ") + (the string form of textLevel's height)) as a line
print ((the string form of "direct level height: ") + (the string form of directLevel's height)) as a line

set textType to the item at 0 in (textModel's wallTypes's values)
set directType to the item at 0 in (directModel's wallTypes's values)
set textLayer0 to the item at 0 in (textType's layers's values)
set directLayer0 to the item at 0 in (directType's layers's values)
set directLayer1 to the item at 1 in (directType's layers's values)
print ((the string form of "text types: ") + (the string form of (the length of (textModel's wallTypes's values)))) as a line
print ((the string form of "direct types: ") + (the string form of (the length of (directModel's wallTypes's values)))) as a line
print ((the string form of "text type name: ") + textType's name) as a line
print ((the string form of "direct type name: ") + directType's name) as a line
print ((the string form of "text type role: ") + (the string form of textType's role)) as a line
print ((the string form of "direct type role: ") + (the string form of directType's role)) as a line
print ((the string form of "text layers: ") + (the string form of (the length of (textType's layers's values)))) as a line
print ((the string form of "direct layers: ") + (the string form of (the length of (directType's layers's values)))) as a line
print ((the string form of "text layer 0: ") + textLayer0's material) as a line
print ((the string form of "direct layer 0: ") + directLayer0's material) as a line
print ((the string form of "text layer 0 thickness: ") + (the string form of textLayer0's thickness)) as a line
print ((the string form of "direct layer 0 thickness: ") + (the string form of directLayer0's thickness)) as a line
print ((the string form of "direct layer 1: ") + directLayer1's material) as a line
print ((the string form of "direct layer 1 thickness: ") + (the string form of directLayer1's thickness)) as a line

set textWall to the item at 0 in (textModel's walls's values)
set directWall to the item at 0 in (directModel's walls's values)
set textStart to textWall's start
set textFinish to textWall's finish
set directStart to directWall's start
set directFinish to directWall's finish
print ((the string form of "text walls: ") + (the string form of (the length of (textModel's walls's values)))) as a line
print ((the string form of "direct walls: ") + (the string form of (the length of (directModel's walls's values)))) as a line
print ((the string form of "text wall type: ") + (the string form of textWall's typeId)) as a line
print ((the string form of "direct wall type: ") + (the string form of directWall's typeId)) as a line
print ((the string form of "text wall level: ") + (the string form of textWall's levelId)) as a line
print ((the string form of "direct wall level: ") + (the string form of directWall's levelId)) as a line
print ((the string form of "text wall start x: ") + (the string form of textStart's x)) as a line
print ((the string form of "direct wall start x: ") + (the string form of directStart's x)) as a line
print ((the string form of "text wall finish x: ") + (the string form of textFinish's x)) as a line
print ((the string form of "direct wall finish x: ") + (the string form of directFinish's x)) as a line
print ((the string form of "text wall height: ") + (the string form of textWall's height)) as a line
print ((the string form of "direct wall height: ") + (the string form of directWall's height)) as a line
print ((the string form of "text wall base: ") + (the string form of textWall's baseOffset)) as a line
print ((the string form of "direct wall base: ") + (the string form of directWall's baseOffset)) as a line
print ((the string form of "text wall top: ") + (the string form of textWall's topLevelId)) as a line
print ((the string form of "direct wall top: ") + (the string form of directWall's topLevelId)) as a line

set textOpeningType to the item at 0 in (textModel's openingTypes's values)
set directOpeningType to the item at 0 in (directModel's openingTypes's values)
print ((the string form of "text opening types: ") + (the string form of (the length of (textModel's openingTypes's values)))) as a line
print ((the string form of "direct opening types: ") + (the string form of (the length of (directModel's openingTypes's values)))) as a line
print ((the string form of "text opening type id: ") + (the string form of textOpeningType's id)) as a line
print ((the string form of "direct opening type id: ") + (the string form of directOpeningType's id)) as a line
print ((the string form of "text opening type name: ") + textOpeningType's name) as a line
print ((the string form of "direct opening type name: ") + directOpeningType's name) as a line
print ((the string form of "text opening type width: ") + (the string form of textOpeningType's width)) as a line
print ((the string form of "direct opening type width: ") + (the string form of directOpeningType's width)) as a line
print ((the string form of "text opening type height: ") + (the string form of textOpeningType's height)) as a line
print ((the string form of "direct opening type height: ") + (the string form of directOpeningType's height)) as a line
print ((the string form of "text opening type sill: ") + (the string form of textOpeningType's sill)) as a line
print ((the string form of "direct opening type sill: ") + (the string form of directOpeningType's sill)) as a line
print ((the string form of "text opening type frame: ") + (the string form of textOpeningType's frame)) as a line
print ((the string form of "direct opening type frame: ") + (the string form of directOpeningType's frame)) as a line
print ((the string form of "text opening type door: ") + (the string form of textOpeningType's isDoor)) as a line
print ((the string form of "direct opening type door: ") + (the string form of directOpeningType's isDoor)) as a line

set textOpening to the item at 0 in (textModel's openings's values)
set directOpening to the item at 0 in (directModel's openings's values)
print ((the string form of "text openings: ") + (the string form of (the length of (textModel's openings's values)))) as a line
print ((the string form of "direct openings: ") + (the string form of (the length of (directModel's openings's values)))) as a line
print ((the string form of "text opening id: ") + (the string form of textOpening's id)) as a line
print ((the string form of "direct opening id: ") + (the string form of directOpening's id)) as a line
print ((the string form of "text opening type: ") + (the string form of textOpening's typeId)) as a line
print ((the string form of "direct opening type: ") + (the string form of directOpening's typeId)) as a line
print ((the string form of "text opening host: ") + (the string form of textOpening's hostId)) as a line
print ((the string form of "direct opening host: ") + (the string form of directOpening's hostId)) as a line
print ((the string form of "text opening offset: ") + (the string form of textOpening's offset)) as a line
print ((the string form of "direct opening offset: ") + (the string form of directOpening's offset)) as a line

set textSlab to the item at 0 in (textModel's slabs's values)
set directSlab to the item at 0 in (directModel's slabs's values)
set textPlate to the item at 1 in (textModel's slabs's values)
set directPlate to the item at 1 in (directModel's slabs's values)
set textCorner to the item at 0 in (textSlab's outline's values)
set directCorner to the item at 0 in (directSlab's outline's values)
print ((the string form of "text slabs: ") + (the string form of (the length of (textModel's slabs's values)))) as a line
print ((the string form of "direct slabs: ") + (the string form of (the length of (directModel's slabs's values)))) as a line
print ((the string form of "text slab id: ") + (the string form of textSlab's id)) as a line
print ((the string form of "direct slab id: ") + (the string form of directSlab's id)) as a line
print ((the string form of "text slab level: ") + (the string form of textSlab's levelId)) as a line
print ((the string form of "direct slab level: ") + (the string form of directSlab's levelId)) as a line
print ((the string form of "text slab thickness: ") + (the string form of textSlab's thickness)) as a line
print ((the string form of "direct slab thickness: ") + (the string form of directSlab's thickness)) as a line
print ((the string form of "text slab material: ") + textSlab's material) as a line
print ((the string form of "direct slab material: ") + directSlab's material) as a line
print ((the string form of "text slab type: ") + (the string form of textSlab's typeId)) as a line
print ((the string form of "direct slab type: ") + (the string form of directSlab's typeId)) as a line
print ((the string form of "text slab corners: ") + (the string form of (the length of (textSlab's outline's values)))) as a line
print ((the string form of "direct slab corners: ") + (the string form of (the length of (directSlab's outline's values)))) as a line
print ((the string form of "text slab corner 0 x: ") + (the string form of textCorner's x)) as a line
print ((the string form of "direct slab corner 0 x: ") + (the string form of directCorner's x)) as a line
print ((the string form of "text plate id: ") + (the string form of textPlate's id)) as a line
print ((the string form of "direct plate id: ") + (the string form of directPlate's id)) as a line
print ((the string form of "text plate type: ") + (the string form of textPlate's typeId)) as a line
print ((the string form of "direct plate type: ") + (the string form of directPlate's typeId)) as a line
print ((the string form of "text plate thickness: ") + (the string form of textPlate's thickness)) as a line
print ((the string form of "direct plate thickness: ") + (the string form of directPlate's thickness)) as a line
print ((the string form of "text plate top: ") + (the string form of textPlate's top)) as a line
print ((the string form of "direct plate top: ") + (the string form of directPlate's top)) as a line
print ((the string form of "text plate heading: ") + (the string form of textPlate's heading)) as a line
print ((the string form of "direct plate heading: ") + (the string form of directPlate's heading)) as a line

set textGrid to the item at 0 in (textModel's grids's values)
set directGrid to the item at 0 in (directModel's grids's values)
set textGridStart to textGrid's start
set textGridFinish to textGrid's finish
set directGridStart to directGrid's start
set directGridFinish to directGrid's finish
print ((the string form of "text grids: ") + (the string form of (the length of (textModel's grids's values)))) as a line
print ((the string form of "direct grids: ") + (the string form of (the length of (directModel's grids's values)))) as a line
print ((the string form of "text grid id: ") + (the string form of textGrid's id)) as a line
print ((the string form of "direct grid id: ") + (the string form of directGrid's id)) as a line
print ((the string form of "text grid name: ") + textGrid's name) as a line
print ((the string form of "direct grid name: ") + directGrid's name) as a line
print ((the string form of "text grid start x: ") + (the string form of textGridStart's x)) as a line
print ((the string form of "direct grid start x: ") + (the string form of directGridStart's x)) as a line
print ((the string form of "text grid finish y: ") + (the string form of textGridFinish's y)) as a line
print ((the string form of "direct grid finish y: ") + (the string form of directGridFinish's y)) as a line
print ((the string form of "text grid low: ") + (the string form of textGrid's low)) as a line
print ((the string form of "direct grid low: ") + (the string form of directGrid's low)) as a line
print ((the string form of "text grid high: ") + (the string form of textGrid's high)) as a line
print ((the string form of "direct grid high: ") + (the string form of directGrid's high)) as a line

set textDimensions to textModel's dimensions's values
set directDimensions to directModel's dimensions's values
set textPlacedDimension to the item at 0 in textDimensions
set directPlacedDimension to the item at 0 in directDimensions
set textPaperDimension to the item at 1 in textDimensions
set directPaperDimension to the item at 1 in directDimensions
set textPlace to textPlacedDimension's place
set directPlace to directPlacedDimension's place
set textOutward to textPaperDimension's outward
set directOutward to directPaperDimension's outward
print ((the string form of "text dimensions: ") + (the string form of (the length of textDimensions))) as a line
print ((the string form of "direct dimensions: ") + (the string form of (the length of directDimensions))) as a line
print ((the string form of "text dimension 0 first: ") + ((the string form of textPlacedDimension's first's elementId) + ((the string form of " ") + (the string form of textPlacedDimension's first's feature)))) as a line
print ((the string form of "direct dimension 0 first: ") + ((the string form of directPlacedDimension's first's elementId) + ((the string form of " ") + (the string form of directPlacedDimension's first's feature)))) as a line
print ((the string form of "text dimension 0 second: ") + ((the string form of textPlacedDimension's second's elementId) + ((the string form of " ") + (the string form of textPlacedDimension's second's feature)))) as a line
print ((the string form of "direct dimension 0 second: ") + ((the string form of directPlacedDimension's second's elementId) + ((the string form of " ") + (the string form of directPlacedDimension's second's feature)))) as a line
print ((the string form of "text dimension 0 placed: ") + (the string form of textPlacedDimension's placed)) as a line
print ((the string form of "direct dimension 0 placed: ") + (the string form of directPlacedDimension's placed)) as a line
print ((the string form of "text dimension 0 place x: ") + (the string form of textPlace's x)) as a line
print ((the string form of "direct dimension 0 place x: ") + (the string form of directPlace's x)) as a line
print ((the string form of "text dimension 0 place y: ") + (the string form of textPlace's y)) as a line
print ((the string form of "direct dimension 0 place y: ") + (the string form of directPlace's y)) as a line
print ((the string form of "text dimension 0 view: ") + (the string form of textPlacedDimension's viewId)) as a line
print ((the string form of "direct dimension 0 view: ") + (the string form of directPlacedDimension's viewId)) as a line
print ((the string form of "text dimension 1 paper: ") + (the string form of textPaperDimension's paperOffset)) as a line
print ((the string form of "direct dimension 1 paper: ") + (the string form of directPaperDimension's paperOffset)) as a line
print ((the string form of "text dimension 1 outward y: ") + (the string form of textOutward's y)) as a line
print ((the string form of "direct dimension 1 outward y: ") + (the string form of directOutward's y)) as a line
print ((the string form of "text dimension 1 view: ") + (the string form of textPaperDimension's viewId)) as a line
print ((the string form of "direct dimension 1 view: ") + (the string form of directPaperDimension's viewId)) as a line

set textSketches to textModel's sketches's values
set directSketches to directModel's sketches's values
set textLineSketch to the item at 0 in textSketches
set directLineSketch to the item at 0 in directSketches
set textFaceSketch to the item at 1 in textSketches
set directFaceSketch to the item at 1 in directSketches
set textWordSketch to the item at 2 in textSketches
set directWordSketch to the item at 2 in directSketches
print ((the string form of "text sketches: ") + (the string form of (the length of textSketches))) as a line
print ((the string form of "direct sketches: ") + (the string form of (the length of directSketches))) as a line
set pieces to an empty list of a string
append (the string form of textLineSketch's kind) to pieces
append (the string form of textLineSketch's levelId) to pieces
append (the string form of (the length of (textLineSketch's points's values))) to pieces
append (the string form of textLineSketch's height) to pieces
print ((the string form of "text line sketch: ") + (pieces joined with " ")) as a line
clear pieces
append (the string form of directLineSketch's kind) to pieces
append (the string form of directLineSketch's levelId) to pieces
append (the string form of (the length of (directLineSketch's points's values))) to pieces
append (the string form of directLineSketch's height) to pieces
print ((the string form of "direct line sketch: ") + (pieces joined with " ")) as a line
clear pieces
append (the string form of textFaceSketch's kind) to pieces
append (the string form of (the length of (textFaceSketch's points's values))) to pieces
append (the string form of textFaceSketch's height) to pieces
print ((the string form of "text face sketch: ") + (pieces joined with " ")) as a line
clear pieces
append (the string form of directFaceSketch's kind) to pieces
append (the string form of (the length of (directFaceSketch's points's values))) to pieces
append (the string form of directFaceSketch's height) to pieces
print ((the string form of "direct face sketch: ") + (pieces joined with " ")) as a line
clear pieces
append (the string form of textWordSketch's kind) to pieces
append (the string form of (the length of (textWordSketch's points's values))) to pieces
append (the string form of textWordSketch's height) to pieces
append textWordSketch's content to pieces
print ((the string form of "text word sketch: ") + (pieces joined with " ")) as a line
clear pieces
append (the string form of directWordSketch's kind) to pieces
append (the string form of (the length of (directWordSketch's points's values))) to pieces
append (the string form of directWordSketch's height) to pieces
append directWordSketch's content to pieces
print ((the string form of "direct word sketch: ") + (pieces joined with " ")) as a line
clear pieces
set textComponents to textModel's components's values
set directComponents to directModel's components's values
set textComponent to the item at 0 in textComponents
set directComponent to the item at 0 in directComponents
set textParts to textComponent's sketches's values
set directParts to directComponent's sketches's values
set textPartFace to the item at 0 in textParts
set directPartFace to the item at 0 in directParts
set textPartLine to the item at 1 in textParts
set directPartLine to the item at 1 in directParts
print ((the string form of "text components: ") + (the string form of (the length of textComponents))) as a line
print ((the string form of "direct components: ") + (the string form of (the length of directComponents))) as a line
append (the string form of textComponent's id) to pieces
append textComponent's name to pieces
append (the string form of (the length of textParts)) to pieces
print ((the string form of "text component: ") + (pieces joined with " ")) as a line
clear pieces
append (the string form of directComponent's id) to pieces
append directComponent's name to pieces
append (the string form of (the length of directParts)) to pieces
print ((the string form of "direct component: ") + (pieces joined with " ")) as a line
clear pieces
append (the string form of textPartFace's kind) to pieces
append (the string form of (the length of (textPartFace's points's values))) to pieces
append (the string form of textPartFace's height) to pieces
append (the string form of textPartFace's levelId) to pieces
print ((the string form of "text part face: ") + (pieces joined with " ")) as a line
clear pieces
append (the string form of directPartFace's kind) to pieces
append (the string form of (the length of (directPartFace's points's values))) to pieces
append (the string form of directPartFace's height) to pieces
append (the string form of directPartFace's levelId) to pieces
print ((the string form of "direct part face: ") + (pieces joined with " ")) as a line
clear pieces
append (the string form of textPartLine's kind) to pieces
append (the string form of (the length of (textPartLine's points's values))) to pieces
append (the string form of textPartLine's height) to pieces
print ((the string form of "text part line: ") + (pieces joined with " ")) as a line
clear pieces
append (the string form of directPartLine's kind) to pieces
append (the string form of (the length of (directPartLine's points's values))) to pieces
append (the string form of directPartLine's height) to pieces
print ((the string form of "direct part line: ") + (pieces joined with " ")) as a line
free pieces

# A record kind this module does not build yet is refused by name, not dropped.
set refusedDocument to the string form of "{\"data\":[{\"attributes\":{\"openbim::stair\":{}}}]}"
set fromRefused to the bim ifcx model of refusedDocument
print ((the string form of "refused kind: ") + ((the string form of fromRefused's valid) + ((the string form of " ") + fromRefused's message))) as a line

# A malformed outline is refused with the kind it belongs to, in the text
# parser's words.
set crossedSlab to the string form of "{\"data\":[{\"attributes\":{\"openbim::slab\":{\"id\":1,\"level\":1,\"thickness\":0.2,\"outline\":[[0,0],[1,1],[1,0],[0,1]]}}}]}"
set fromCrossedSlab to the bim ifcx model of crossedSlab
print ((the string form of "crossed slab: ") + fromCrossedSlab's message) as a line
set shortSlab to the string form of "{\"data\":[{\"attributes\":{\"openbim::slab\":{\"id\":1,\"level\":1,\"thickness\":0.2,\"outline\":[[0,0],[1,1]]}}}]}"
set fromShortSlab to the bim ifcx model of shortSlab
print ((the string form of "short slab: ") + fromShortSlab's message) as a line
set crossedPlate to the string form of "{\"data\":[{\"attributes\":{\"openbim::slab\":{\"id\":1,\"level\":1,\"type\":9,\"top\":0.0,\"pitch\":0.0,\"heading\":0.0,\"outline\":[[0,0],[1,1],[1,0],[0,1]]}}}]}"
set fromCrossedPlate to the bim ifcx model of crossedPlate
print ((the string form of "crossed plate: ") + fromCrossedPlate's message) as a line

# A wall's line comes before its foot and top, as the text parser reads them.
set shortWall to the string form of "{\"data\":[{\"attributes\":{\"openbim::wall\":{\"id\":1,\"type\":2,\"level\":1,\"start\":[0,0],\"finish\":[0,0],\"height\":3,\"bulge\":0}}}]}"
set fromShortWall to the bim ifcx model of shortWall
print ((the string form of "short wall: ") + fromShortWall's message) as a line
set unstartedWall to the string form of "{\"data\":[{\"attributes\":{\"openbim::wall\":{\"id\":1,\"type\":2,\"level\":1,\"finish\":[4,0],\"height\":3,\"bulge\":0}}}]}"
set fromUnstartedWall to the bim ifcx model of unstartedWall
print ((the string form of "unstarted wall: ") + fromUnstartedWall's message) as a line
set badTopWall to the string form of "{\"data\":[{\"attributes\":{\"openbim::wall\":{\"id\":1,\"type\":2,\"level\":1,\"start\":[0,0],\"finish\":[4,0],\"height\":3,\"bulge\":0,\"topLevel\":\"x\"}}}]}"
set fromBadTopWall to the bim ifcx model of badTopWall
print ((the string form of "bad top wall: ") + fromBadTopWall's message) as a line

# The new kinds keep the text parser's words, and their unbuilt members are
# refused by name.
set crossedFace to the string form of "{\"data\":[{\"attributes\":{\"openbim::sketch\":{\"id\":1,\"level\":1,\"kind\":1,\"height\":0,\"points\":[[0,0],[1,1],[1,0],[0,1]],\"text\":\"\"}}}]}"
set fromCrossedFace to the bim ifcx model of crossedFace
print ((the string form of "crossed face: ") + fromCrossedFace's message) as a line
set connectedComponent to the string form of "{\"data\":[{\"attributes\":{\"openbim::component\":{\"id\":1,\"name\":\"Frame\",\"parts\":[],\"connectors\":[]}}}]}"
set fromConnectedComponent to the bim ifcx model of connectedComponent
print ((the string form of "connected component: ") + fromConnectedComponent's message) as a line
