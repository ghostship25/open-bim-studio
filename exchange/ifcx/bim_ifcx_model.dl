# SPDX-License-Identifier: MPL-2.0
# Builds a model straight from an IfcX document's `openbim::` records, without
# writing `.bim` text for the text parser to read back (#161, step 3).
#
# The groups so far cover the frame and the wall set: the project's `next`, a
# level, a wall type with its layers, and a wall with its base offset and top
# level; then the opening types and their openings, the slabs (and the plates
# of a planar type), the grid lines, the dimensions, the sketches and the
# components with their parts, their connectors and their solids; then the
# instances, the free meshes, the linear types and the linear elements; and then
# the spaces, the tags and the views. A record kind this module does not build
# yet is refused by name, so content is never silently dropped.
#
# Construction mirrors `the bim model parsed from` rule for rule: ids ascend,
# a level has a positive height, a wall type has at least one layer of positive
# thickness, a wall stays inside its own bulge, lean and rise. The finished
# model is checked once by `the bim reference fault of`, exactly as the text
# reader checks it, and its type names follow the naming rules.
import lib/json.dl
import bim/bim_index.dl
import exchange/ifcx/bim_readings.dl

class:
    patterns:
        [a|] bim ifcx model result record
    members:
        valid as a boolean
        modelValue as a bim model record
        message as a string

class:
    patterns:
        [a|] bim ifcx model sketch reading
    members:
        valid as a boolean
        sketchValue as a bim sketch record
        message as a string

class:
    patterns:
        [a|] bim ifcx model point reading
    members:
        valid as a boolean
        point as a cad vector3

local function a bim ifcx model refusal saying {a string:reason}:
    execute:
        return @intrinsic("construct", a bim ifcx model result record, false, an empty bim model, reason)

# The JSON member `key` of `record`, or no value when it has none.
local function the bim ifcx model member {a string:key} of {a pointer to a JSON value:record}:
    execute:
        if (the kind of record) = the JSON object kind:
            if record has JSON member named key:
                return the JSON member named key in record
        return 0 as a pointer to a JSON value

local function the bim ifcx model whole {a string:key} of {a pointer to a JSON value:record}:
    execute:
        set entry to the bim ifcx model member key of record
        if entry = (0 as a pointer to a JSON value):
            return @intrinsic("construct", a bim whole reading record, false, 0 as a 64 bit integer)
        if (the kind of entry) != the JSON number kind:
            return @intrinsic("construct", a bim whole reading record, false, 0 as a 64 bit integer)
        return the bim whole reading of (the text of entry)

local function the bim ifcx model real {a string:key} of {a pointer to a JSON value:record}:
    execute:
        set entry to the bim ifcx model member key of record
        if entry = (0 as a pointer to a JSON value):
            return @intrinsic("construct", a bim real reading record, false, 0.0)
        if (the kind of entry) != the JSON number kind:
            return @intrinsic("construct", a bim real reading record, false, 0.0)
        return the bim real reading of (the text of entry)

# A text field: line breaks become spaces, as the native file writes them.
local function the bim ifcx model text {a string:key} of {a pointer to a JSON value:record}:
    execute:
        set entry to the bim ifcx model member key of record
        if entry = (0 as a pointer to a JSON value):
            return the string form of ""
        if (the kind of entry) = the JSON text kind:
            return ((the text of entry) with "\n" replaced by " ") with "\r" replaced by " "
        return the string form of ""

# True when `wanted` is above the last id of `records`, so `records` stays in
# ascending id order.
local function bim ifcx model id {a 64 bit integer:wanted} follows {a pointer to a list:records}:
    execute:
        if (the length of records) = 0:
            return true
        return (the item at ((the length of records) - 1) in records)'s id < wanted

# The `slot`th number of the two-number array `key` of `record` (`[x, y]`),
# refused unless it is one.
local function the bim ifcx model number {an integer:slot} of {a string:key} in {a pointer to a JSON value:record}:
    execute:
        set refused to @intrinsic("construct", a bim real reading record, false, 0.0)
        set entry to the bim ifcx model member key of record
        if entry = (0 as a pointer to a JSON value):
            return refused
        if (the kind of entry) != the JSON array kind:
            return refused
        if (the length of entry) != 2:
            return refused
        return the bim real reading of (the text of (the JSON value at index slot in entry))

# The `slot`th whole number of the two-number array `key` of `record`, refused
# unless it is one: an element or feature reference, as the native file writes
# it.
local function the bim ifcx model whole at {an integer:slot} of {a string:key} in {a pointer to a JSON value:record}:
    execute:
        set refused to @intrinsic("construct", a bim whole reading record, false, 0 as a 64 bit integer)
        set entry to the bim ifcx model member key of record
        if entry = (0 as a pointer to a JSON value):
            return refused
        if (the kind of entry) != the JSON array kind:
            return refused
        if (the length of entry) != 2:
            return refused
        return the bim whole reading of (the text of (the JSON value at index slot in entry))

# The pair at `slot` of `entry` appended to `outline`; false when it is not a
# pair of numbers.
local function add bim ifcx model point at {an integer:slot} of {a pointer to a JSON value:entry} to {a pointer to a cad topology list:outline}:
    execute:
        set pointEntry to the JSON value at index slot in entry
        if (the kind of pointEntry) != the JSON array kind:
            return false
        if (the length of pointEntry) != 2:
            return false
        set across to the bim real reading of (the text of (the JSON value at index 0 in pointEntry))
        set upward to the bim real reading of (the text of (the JSON value at index 1 in pointEntry))
        if (across's valid and upward's valid) = false:
            return false
        append (a cad vector2 with x across's value and y upward's value) to (outline's values)
        return true

# The three numbers at `slot` of the array `entry` as a point; refused unless
# the array holds them.
local function the bim ifcx model triple at {an integer:slot} of {a pointer to a JSON value:entry}:
    execute:
        set refused to @intrinsic("construct", a bim ifcx model point reading, false, (a cad vector3 with x 0.0, y 0.0 and z 0.0))
        if (the kind of entry) != the JSON array kind:
            return refused
        if (the length of entry) < (slot + 3):
            return refused
        set across to the bim real reading of (the text of (the JSON value at index slot in entry))
        set upward to the bim real reading of (the text of (the JSON value at index (slot + 1) in entry))
        set rising to the bim real reading of (the text of (the JSON value at index (slot + 2) in entry))
        if ((across's valid and upward's valid) and rising's valid) = false:
            return refused
        return @intrinsic("construct", a bim ifcx model point reading, true, (a cad vector3 with x across's value, y upward's value and z rising's value))

# The three numbers of `key` as a point: refused unless it is one.
local function the bim ifcx model point {a string:key} of {a pointer to a JSON value:record}:
    execute:
        set refused to @intrinsic("construct", a bim ifcx model point reading, false, (a cad vector3 with x 0.0, y 0.0 and z 0.0))
        set entry to the bim ifcx model member key of record
        if entry = (0 as a pointer to a JSON value):
            return refused
        if (the kind of entry) != the JSON array kind:
            return refused
        if (the length of entry) != 3:
            return refused
        return the bim ifcx model triple at 0 of entry

# The pairs of `entry` appended to `profile`; false when it is not a list of
# pairs of numbers.
local function add bim ifcx model profile of {a pointer to a JSON value:entry} to {a pointer to a cad topology list:profile}:
    execute:
        if (the kind of entry) != the JSON array kind:
            return false
        loop cursor from 0 to the length of entry:
            if (add bim ifcx model point at cursor of entry to profile) = false:
                return false
        return true

# The triples of `entry` appended to `points`; false when it is not a list of
# triples of numbers.
local function add bim ifcx model mesh points of {a pointer to a JSON value:entry} to {a pointer to a cad topology list:points}:
    execute:
        if (the kind of entry) != the JSON array kind:
            return false
        loop cursor from 0 to the length of entry:
            set reading to the bim ifcx model triple at 0 of (the JSON value at index cursor in entry)
            if reading's valid = false:
                return false
            append reading's point to (points's values)
        return true

# The point numbers of `entry` appended to `faces`; false when one is not a
# point number.
local function add bim ifcx model faces of {a pointer to a JSON value:entry} to {a pointer to a cad topology list:faces}:
    execute:
        if (the kind of entry) != the JSON array kind:
            return false
        loop cursor from 0 to the length of entry:
            set number to the bim whole reading of (the text of (the JSON value at index cursor in entry))
            if (number's valid = false) or ((number's value < (0 as a 64 bit integer)) or (number's value > (10000000 as a 64 bit integer))):
                return false
            append (number's value as an integer) to (faces's values)
        return true

# ---------------------------------------------------------------- the records

local function add bim ifcx model level {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set elevation to the bim ifcx model real (the string form of "elevation") of record
        set height to the bim ifcx model real (the string form of "height") of record
        if ((id's valid and elevation's valid) and height's valid) = false:
            return the string form of "malformed level"
        if (bim ifcx model id id's value follows (modelValue's levels's values)) = false:
            return the string form of "level ids out of order"
        if height's value <= 0.0:
            return the string form of "a level needs a positive height"
        append (@intrinsic("construct", a bim level record, id's value, (the bim ifcx model text (the string form of "name") of record), elevation's value, height's value)) to (modelValue's levels's values)
        return the string form of ""

local function add bim ifcx model wall type {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        if id's valid = false:
            return the string form of "malformed walltype"
        if (bim ifcx model id id's value follows (modelValue's wallTypes's values)) = false:
            return the string form of "walltype ids out of order"
        set role to bim wall planar role
        set roleText to the bim ifcx model text (the string form of "role") of record
        if (the length of roleText) > 0:
            set roleReading to the bim whole reading of roleText
            if roleReading's valid = false:
                return the string form of "malformed planartype"
            if ((roleReading's value < (1 as a 64 bit integer)) or (roleReading's value > (3 as a 64 bit integer))):
                return the string form of "a planar type's role is 1, 2 or 3"
            set role to roleReading's value as an integer
        set typeValue to @intrinsic("construct", a bim wall type record, id's value, (the bim ifcx model text (the string form of "name") of record), a cad topology list of a bim layer record, role)
        append typeValue to (modelValue's wallTypes's values)
        set layersEntry to the bim ifcx model member (the string form of "layers") of record
        if layersEntry != (0 as a pointer to a JSON value):
            if (the kind of layersEntry) = the JSON array kind:
                set owner to (the item at ((the length of (modelValue's wallTypes's values)) - 1) in (modelValue's wallTypes's values))
                loop cursor from 0 to the length of layersEntry:
                    set layerEntry to the JSON value at index cursor in layersEntry
                    set usable to false
                    if (the kind of layerEntry) = the JSON array kind:
                        set usable to (the length of layerEntry) = 2
                    if usable:
                        set material to the JSON value at index 0 in layerEntry
                        if (the kind of material) != the JSON text kind:
                            return the string form of "malformed layer"
                        set thickness to the bim real reading of (the text of (the JSON value at index 1 in layerEntry))
                        if (thickness's valid = false) or (thickness's value <= 0.0):
                            return the string form of "a layer needs a positive thickness"
                        append (@intrinsic("construct", a bim layer record, (the text of material), thickness's value)) to (owner's layers's values)
                    else:
                        return the string form of "malformed layer"
        return the string form of ""

# A wall: its line, which `wallbase` and `walltop` may then lift and cap. The
# refusals are the text parser's, in its order: the wall line's own faults
# before the foot and the top that follow it.
local function add bim ifcx model wall {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set typeId to the bim ifcx model whole (the string form of "type") of record
        set levelId to the bim ifcx model whole (the string form of "level") of record
        set startX to the bim ifcx model number 0 of (the string form of "start") in record
        set startY to the bim ifcx model number 1 of (the string form of "start") in record
        set finishX to the bim ifcx model number 0 of (the string form of "finish") in record
        set finishY to the bim ifcx model number 1 of (the string form of "finish") in record
        set height to the bim ifcx model real (the string form of "height") of record
        set bulge to the bim ifcx model real (the string form of "bulge") of record
        set endsValid to (startX's valid and startY's valid) and (finishX's valid and finishY's valid)
        set fieldsValid to (id's valid and typeId's valid) and (levelId's valid and endsValid)
        set measuresValid to height's valid and bulge's valid
        if (fieldsValid and measuresValid) = false:
            return the string form of "malformed wall"
        if (bim ifcx model id id's value follows (modelValue's walls's values)) = false:
            return the string form of "wall ids out of order"
        set startPoint to a cad vector2 with x startX's value and y startY's value
        set finishPoint to a cad vector2 with x finishX's value and y finishY's value
        set span to the cad distance from startPoint to finishPoint
        if (span <= 1e-6) or (height's value <= 0.0):
            return the string form of "a wall needs a length and a positive height"
        if (the absolute value of bulge's value) > (span * 0.5):
            return the string form of "a wall's bulge exceeds a half circle"
        # A shaped wall writes its lean and its rise together, or writes neither.
        set leanValue to 0.0
        set riseValue to 0.0
        if (the bim ifcx model member (the string form of "lean") of record) != (0 as a pointer to a JSON value):
            set lean to the bim ifcx model real (the string form of "lean") of record
            set rise to the bim ifcx model real (the string form of "rise") of record
            if (lean's valid and rise's valid) = false:
                return the string form of "malformed wall"
            set leanValue to lean's value
            set riseValue to rise's value
        if ((the absolute value of leanValue) >= height's value) or ((the absolute value of riseValue) >= height's value):
            return the string form of "a wall's lean or rise reaches its height"
        set baseValue to 0.0
        if (the bim ifcx model member (the string form of "baseOffset") of record) != (0 as a pointer to a JSON value):
            set baseOffset to the bim ifcx model real (the string form of "baseOffset") of record
            if baseOffset's valid = false:
                return the string form of "malformed wallbase"
            set baseValue to baseOffset's value
        set topLevelId to the bim refused id
        if (the bim ifcx model member (the string form of "topLevel") of record) != (0 as a pointer to a JSON value):
            set topLevel to the bim ifcx model whole (the string form of "topLevel") of record
            if topLevel's valid = false:
                return the string form of "malformed walltop"
            set topLevelId to topLevel's value
        append (@intrinsic("construct", a bim wall record, id's value, typeId's value, levelId's value, startPoint, finishPoint, height's value, bulge's value, leanValue, riseValue, baseValue, topLevelId)) to (modelValue's walls's values)
        return the string form of ""

# The flag `key` of `record` as 0 or 1: a boolean, or the number a native file
# writes. Refused unless it is one, as the text parser refuses it.
local function bim ifcx model flag {a string:key} of {a pointer to a JSON value:record}:
    execute:
        set refused to @intrinsic("construct", a bim whole reading record, false, 0 as a 64 bit integer)
        set off to @intrinsic("construct", a bim whole reading record, true, 0 as a 64 bit integer)
        set entry to the bim ifcx model member key of record
        if entry = (0 as a pointer to a JSON value):
            return refused
        if (the kind of entry) = the JSON boolean kind:
            if the boolean of entry:
                return @intrinsic("construct", a bim whole reading record, true, 1 as a 64 bit integer)
            return off
        if (the kind of entry) != the JSON number kind:
            return refused
        set reading to the bim whole reading of (the text of entry)
        if reading's valid = false:
            return refused
        if (reading's value < (0 as a 64 bit integer)) or (reading's value > (1 as a 64 bit integer)):
            return refused
        return reading

# `record`'s outline into `outline`, read as a `noun`'s ring: at least three
# corners that do not cross themselves. Empty when it is sound; the refusals
# name the noun, as the text parser's do.
local function the bim ifcx model outline of {a pointer to a JSON value:record} named {a string:noun} into {a pointer to a cad topology list:outline}:
    execute:
        set malformed to ((the string form of "malformed ") + noun)
        set entry to the bim ifcx model member (the string form of "outline") of record
        if entry = (0 as a pointer to a JSON value):
            return malformed
        if (the kind of entry) != the JSON array kind:
            return malformed
        if (the length of entry) < 3:
            return (((the string form of "a ") + noun) + (the string form of " needs at least 3 corners"))
        loop cursor from 0 to the length of entry:
            if (add bim ifcx model point at cursor of entry to outline) = false:
                return (malformed + (the string form of " corner"))
        if (bim outline (outline's values) is simple) = false:
            return (((the string form of "a ") + noun) + (the string form of " outline must not cross itself"))
        return the string form of ""

local function add bim ifcx model opening type {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set width to the bim ifcx model real (the string form of "width") of record
        set height to the bim ifcx model real (the string form of "height") of record
        set sill to the bim ifcx model real (the string form of "sill") of record
        set frame to the bim ifcx model real (the string form of "frame") of record
        if ((((id's valid and width's valid) and height's valid) and sill's valid) and frame's valid) = false:
            return the string form of "malformed openingtype"
        if (bim ifcx model id id's value follows (modelValue's openingTypes's values)) = false:
            return the string form of "openingtype ids out of order"
        set doorReading to bim ifcx model flag (the string form of "door") of record
        if doorReading's valid = false:
            return the string form of "malformed openingtype"
        set door to doorReading's value = (1 as a 64 bit integer)
        set doorFault to door and (sill's value != 0.0)
        set sizesValid to (width's value > 0.0) and (height's value > 0.0)
        set offsetsValid to (sill's value >= 0.0) and (frame's value >= 0.0)
        if ((sizesValid and offsetsValid) and (doorFault = false)) = false:
            return the string form of "an opening type needs positive sizes, and a door a sill of 0"
        append (@intrinsic("construct", a bim opening type record, id's value, (the bim ifcx model text (the string form of "name") of record), width's value, height's value, sill's value, frame's value, door)) to (modelValue's openingTypes's values)
        return the string form of ""

local function add bim ifcx model opening {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set typeId to the bim ifcx model whole (the string form of "type") of record
        set hostId to the bim ifcx model whole (the string form of "host") of record
        set offset to the bim ifcx model real (the string form of "offset") of record
        if (((id's valid and typeId's valid) and hostId's valid) and offset's valid) = false:
            return the string form of "malformed opening"
        if (bim ifcx model id id's value follows (modelValue's openings's values)) = false:
            return the string form of "opening ids out of order"
        append (@intrinsic("construct", a bim opening record, id's value, typeId's value, hostId's value, offset's value)) to (modelValue's openings's values)
        return the string form of ""

local function add bim ifcx model slab {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set levelId to the bim ifcx model whole (the string form of "level") of record
        if (id's valid and levelId's valid) = false:
            return the string form of "malformed slab"
        if (bim ifcx model id id's value follows (modelValue's slabs's values)) = false:
            return the string form of "slab ids out of order"
        set typeReading to the bim ifcx model whole (the string form of "type") of record
        set noun to the string form of "slab"
        if typeReading's valid:
            set noun to the string form of "plate"
        set outline to a cad topology list of a cad vector2
        set outlineFault to the bim ifcx model outline of record named noun into (the address of outline)
        if (the length of outlineFault) > 0:
            return outlineFault
        if typeReading's valid:
            # A plate of a planar type: its thickness follows from the type.
            set top to the bim ifcx model real (the string form of "top") of record
            set pitch to the bim ifcx model real (the string form of "pitch") of record
            set heading to the bim ifcx model real (the string form of "heading") of record
            if ((top's valid and pitch's valid) and heading's valid) = false:
                return the string form of "malformed plate"
            if (the absolute value of pitch's value) >= 1.5:
                return the string form of "a plate's pitch must stay below a right angle"
            set typeFound to the bim wall type index of typeReading's value in (@intrinsic("dereference", modelValue))
            if typeFound's valid = false:
                return the string form of "a plate refers to a missing planar type"
            set plateTypeValue to the item at typeFound's position in (modelValue's wallTypes's values)
            append (@intrinsic("construct", a bim slab record, id's value, levelId's value, outline, (the bim thickness of plateTypeValue), (the string form of "concrete"), typeReading's value, top's value, pitch's value, heading's value)) to (modelValue's slabs's values)
            return the string form of ""
        set thickness to the bim ifcx model real (the string form of "thickness") of record
        if thickness's valid = false:
            return the string form of "malformed slab"
        if thickness's value <= 0.0:
            return the string form of "a slab needs a positive thickness"
        set material to the bim ifcx model text (the string form of "material") of record
        if (the length of material) = 0:
            set material to the string form of "concrete"
        append (@intrinsic("construct", a bim slab record, id's value, levelId's value, outline, thickness's value, material, the bim refused id, 0.0, 0.0, 0.0)) to (modelValue's slabs's values)
        return the string form of ""

local function add bim ifcx model grid {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set low to the bim ifcx model real (the string form of "low") of record
        set high to the bim ifcx model real (the string form of "high") of record
        set startX to the bim ifcx model number 0 of (the string form of "start") in record
        set startY to the bim ifcx model number 1 of (the string form of "start") in record
        set finishX to the bim ifcx model number 0 of (the string form of "finish") in record
        set finishY to the bim ifcx model number 1 of (the string form of "finish") in record
        set endsValid to (startX's valid and startY's valid) and (finishX's valid and finishY's valid)
        if ((id's valid and low's valid) and (high's valid and endsValid)) = false:
            return the string form of "malformed grid"
        if (bim ifcx model id id's value follows (modelValue's grids's values)) = false:
            return the string form of "grid ids out of order"
        set startPoint to a cad vector2 with x startX's value and y startY's value
        set finishPoint to a cad vector2 with x finishX's value and y finishY's value
        if ((the cad distance from startPoint to finishPoint) <= 1e-6) or (high's value <= low's value):
            return the string form of "a grid needs a length and a height"
        append (@intrinsic("construct", a bim grid record, id's value, (the bim ifcx model text (the string form of "name") of record), startPoint, finishPoint, low's value, high's value)) to (modelValue's grids's values)
        return the string form of ""

# A dimension: two references and, where it is placed, the line it is drawn
# through. A paper offset and its outward, and then the view they belong to,
# sit inside `place`, as the native line nests them.
local function add bim ifcx model dimension {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set firstElement to the bim ifcx model whole at 0 of (the string form of "first") in record
        set firstFeature to the bim ifcx model whole at 1 of (the string form of "first") in record
        set secondElement to the bim ifcx model whole at 0 of (the string form of "second") in record
        set secondFeature to the bim ifcx model whole at 1 of (the string form of "second") in record
        set endsValid to (firstElement's valid and firstFeature's valid) and (secondElement's valid and secondFeature's valid)
        if (id's valid and endsValid) = false:
            return the string form of "malformed dimension"
        set placed to (the bim ifcx model member (the string form of "place") of record) != (0 as a pointer to a JSON value)
        set placeX to the bim ifcx model number 0 of (the string form of "place") in record
        set placeY to the bim ifcx model number 1 of (the string form of "place") in record
        if placed and ((placeX's valid and placeY's valid) = false):
            return the string form of "malformed dimension"
        set paperOffset to 0.0
        set outwardX to 0.0
        set outwardY to 0.0
        set viewId to the bim refused id
        if placed and ((the bim ifcx model member (the string form of "outward") of record) != (0 as a pointer to a JSON value)):
            set paper to the bim ifcx model real (the string form of "paperOffset") of record
            set across to the bim ifcx model number 0 of (the string form of "outward") in record
            set upward to the bim ifcx model number 1 of (the string form of "outward") in record
            if ((paper's valid and across's valid) and upward's valid) = false:
                return the string form of "malformed dimension"
            set paperOffset to paper's value
            set outwardX to across's value
            set outwardY to upward's value
            if (the bim ifcx model member (the string form of "view") of record) != (0 as a pointer to a JSON value):
                set view to the bim ifcx model whole (the string form of "view") of record
                if view's valid = false:
                    return the string form of "malformed dimension"
                set viewId to view's value
        if (bim ifcx model id id's value follows (modelValue's dimensions's values)) = false:
            return the string form of "dimension ids out of order"
        set placePoint to a cad vector2 with x 0.0 and y 0.0
        if placed:
            set placePoint to a cad vector2 with x placeX's value and y placeY's value
        set firstEnd to @intrinsic("construct", a bim reference record, firstElement's value, firstFeature's value as an integer)
        set secondEnd to @intrinsic("construct", a bim reference record, secondElement's value, secondFeature's value as an integer)
        append (@intrinsic("construct", a bim dimension record, id's value, firstEnd, secondEnd, placed, placePoint, paperOffset, (a cad vector2 with x outwardX and y outwardY), viewId)) to (modelValue's dimensions's values)
        return the string form of ""

local function a bim ifcx model sketch refusal saying {a string:reason}:
    execute:
        set blank to @intrinsic("construct", a bim sketch record, the bim refused id, 0 as a 64 bit integer, bim line sketch, a cad topology list of a cad vector2, 0.0, (the string form of ""))
        return @intrinsic("construct", a bim ifcx model sketch reading, false, blank, reason)

# The sketch `record` on `levelId` as the text parser reads one: its kind fixes
# how many points it has, and a text or an image sketch carries its words or
# its path after them. A sketch of its own follows the one with id `lastId`; a
# part of a component, on no level of its own, has no order either.
local function the bim ifcx model sketch of {a pointer to a JSON value:record} on {a 64 bit integer:levelId} after {a 64 bit integer:lastId}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set kind to the bim ifcx model whole (the string form of "kind") of record
        set height to the bim ifcx model real (the string form of "height") of record
        if ((id's valid and kind's valid) and height's valid) = false:
            return a bim ifcx model sketch refusal saying (the string form of "malformed sketch")
        set kindCode to kind's value as an integer
        set pointsEntry to the bim ifcx model member (the string form of "points") of record
        set pointCount to 0
        set hasPoints to false
        if pointsEntry != (0 as a pointer to a JSON value):
            if (the kind of pointsEntry) = the JSON array kind:
                set pointCount to the length of pointsEntry
                set hasPoints to true
        set shaped to false
        if hasPoints:
            if (kindCode = bim line sketch) and (pointCount = 2):
                set shaped to true
            if (kindCode = bim face sketch) and (pointCount >= 3):
                set shaped to true
            if (kindCode = bim text sketch) and (pointCount = 1):
                set shaped to true
            if (kindCode = bim image sketch) and (pointCount = 4):
                set shaped to true
        if shaped = false:
            return a bim ifcx model sketch refusal saying (the string form of "malformed sketch")
        if (lastId >= (0 as a 64 bit integer)) and (id's value <= lastId):
            return a bim ifcx model sketch refusal saying (the string form of "sketch ids out of order")
        if height's value < 0.0:
            return a bim ifcx model sketch refusal saying (the string form of "a mass needs a height of 0 or more")
        set points to a cad topology list of a cad vector2
        set pointsFault to false
        loop cursor from 0 to pointCount:
            if pointsFault = false:
                if (add bim ifcx model point at cursor of pointsEntry to (the address of points)) = false:
                    set pointsFault to true
        if pointsFault:
            return a bim ifcx model sketch refusal saying (the string form of "malformed sketch point")
        set content to the string form of ""
        if (kindCode = bim text sketch) or (kindCode = bim image sketch):
            set content to the bim ifcx model text (the string form of "text") of record
        if (kindCode = bim face sketch) and ((bim outline (points's values) is simple) = false):
            return a bim ifcx model sketch refusal saying (the string form of "a face outline must not cross itself")
        return @intrinsic("construct", a bim ifcx model sketch reading, true, (@intrinsic("construct", a bim sketch record, id's value, levelId, kindCode, points, height's value, content)), (the string form of ""))

# A sketch of the model, on the level its record names.
local function add bim ifcx model element sketch {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set levelId to the bim ifcx model whole (the string form of "level") of record
        if levelId's valid = false:
            return the string form of "malformed sketch"
        set earlier to modelValue's sketches's values
        set lastId to the bim refused id
        if (the length of earlier) > 0:
            set lastId to (the last item of earlier)'s id
        set reading to the bim ifcx model sketch of record on levelId's value after lastId
        if reading's valid = false:
            return reading's message
        append reading's sketchValue to (modelValue's sketches's values)
        return the string form of ""

# A solid part of a component, read as the text parser reads a solid line: its
# kind and operation, where it stands and how big it is, the profile it is
# extruded from and the mesh it is made of, and the material it is of. A face
# must fit the points it names.
local function add bim ifcx model solid {a pointer to a JSON value:record} into {a pointer to a cad topology list:solids}:
    execute:
        set kind to the bim ifcx model whole (the string form of "kind") of record
        set operation to the bim ifcx model whole (the string form of "operation") of record
        set origin to the bim ifcx model point (the string form of "origin") of record
        set size to the bim ifcx model point (the string form of "size") of record
        set angle to the bim ifcx model real (the string form of "angle") of record
        if ((((kind's valid and operation's valid) and (origin's valid and size's valid)) and angle's valid) = false):
            return the string form of "malformed solid"
        set profile to a cad topology list of a cad vector2
        set profileEntry to the bim ifcx model member (the string form of "profile") of record
        if profileEntry != (0 as a pointer to a JSON value):
            if (add bim ifcx model profile of profileEntry to (the address of profile)) = false:
                return the string form of "malformed solid point"
        set points to a cad topology list of a cad vector3
        set pointsEntry to the bim ifcx model member (the string form of "points") of record
        if pointsEntry != (0 as a pointer to a JSON value):
            if (add bim ifcx model mesh points of pointsEntry to (the address of points)) = false:
                return the string form of "malformed solid point"
        set faces to a cad topology list of an integer
        set facesEntry to the bim ifcx model member (the string form of "faces") of record
        if facesEntry != (0 as a pointer to a JSON value):
            if (add bim ifcx model faces of facesEntry to (the address of faces)) = false:
                return the string form of "malformed solid face"
        if ((the length of (faces's values)) > 0) and ((bim mesh faces (faces's values) fit (the length of (points's values))) = false):
            return the string form of "a solid's face refers to a missing point"
        set kindCode to kind's value as an integer
        set operationCode to operation's value as an integer
        if ((kindCode < 0) or (kindCode > 4)) or ((operationCode < 0) or (operationCode > 2)):
            return the string form of "unknown solid kind or operation"
        append (@intrinsic("construct", a bim solid part record, kindCode, operationCode, origin's point, size's point, angle's value, profile, (the bim ifcx model text (the string form of "material") of record), points, faces)) to (solids's values)
        return the string form of ""

# The solids of the array `entry` appended to `solids`, each read as a solid
# line; the first fault is returned.
local function add bim ifcx model solids of {a pointer to a JSON value:entry} into {a pointer to a cad topology list:solids}:
    execute:
        if (the kind of entry) != the JSON array kind:
            return the string form of "malformed solid"
        set fault to the string form of ""
        loop cursor from 0 to the length of entry:
            if (the length of fault) = 0:
                set fault to (add bim ifcx model solid (the JSON value at index cursor in entry) into solids)
        return fault

# A connector of a component, read as the text parser reads a connector line:
# its spot and the direction out of it, its size, and the role of the segments
# it takes.
local function add bim ifcx model connector {a pointer to a JSON value:entry} to {a pointer to a cad topology list:connectors}:
    execute:
        if (the kind of entry) != the JSON array kind:
            return false
        if (the length of entry) != 8:
            return false
        set spot to the bim ifcx model triple at 0 of entry
        set direction to the bim ifcx model triple at 3 of entry
        set size to the bim real reading of (the text of (the JSON value at index 6 in entry))
        set role to the bim whole reading of (the text of (the JSON value at index 7 in entry))
        if ((spot's valid and direction's valid) and (size's valid and role's valid)) = false:
            return false
        append (@intrinsic("construct", a bim component connector record, spot's point, direction's point, size's value, role's value as an integer)) to (connectors's values)
        return true

# A component: its name and the parts it is built from, then the connectors its
# services join at and the solids it is made of. A component with connectors
# carries the role they are for, as a connector line does.
local function add bim ifcx model component {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        if id's valid = false:
            return the string form of "malformed component"
        if (bim ifcx model id id's value follows (modelValue's components's values)) = false:
            return the string form of "component ids out of order"
        set parts to a cad topology list of a bim sketch record
        set fault to the string form of ""
        set partsEntry to the bim ifcx model member (the string form of "parts") of record
        set partsListed to false
        if partsEntry != (0 as a pointer to a JSON value):
            set partsListed to (the kind of partsEntry) = the JSON array kind
        if partsListed:
            loop cursor from 0 to the length of partsEntry:
                if (the length of fault) = 0:
                    set partReading to the bim ifcx model sketch of (the JSON value at index cursor in partsEntry) on (0 as a 64 bit integer) after (the bim refused id)
                    if partReading's valid = false:
                        set fault to partReading's message
                    else:
                        append partReading's sketchValue to (parts's values)
        set role to 0
        set roleReading to the bim ifcx model whole (the string form of "role") of record
        set connectors to a cad topology list of a bim component connector record
        set connectorsEntry to the bim ifcx model member (the string form of "connectors") of record
        set connectorsListed to false
        if connectorsEntry != (0 as a pointer to a JSON value):
            set connectorsListed to (the kind of connectorsEntry) = the JSON array kind
            if (connectorsListed = false) and ((the length of fault) = 0):
                set fault to the string form of "malformed connector"
        if connectorsListed:
            if (roleReading's valid = false) and ((the length of connectorsEntry) > 0):
                if (the length of fault) = 0:
                    set fault to the string form of "malformed connector"
            if roleReading's valid:
                set role to roleReading's value as an integer
            loop cursor from 0 to the length of connectorsEntry:
                if (the length of fault) = 0:
                    if (add bim ifcx model connector (the JSON value at index cursor in connectorsEntry) to (the address of connectors)) = false:
                        set fault to the string form of "malformed connector"
        set solids to a cad topology list of a bim solid part record
        if (the length of fault) = 0:
            set solidsEntry to the bim ifcx model member (the string form of "solids") of record
            if solidsEntry != (0 as a pointer to a JSON value):
                set fault to (add bim ifcx model solids of solidsEntry into (the address of solids))
        if (the length of fault) > 0:
            return fault
        append (@intrinsic("construct", a bim component record, id's value, (the bim ifcx model text (the string form of "name") of record), parts, solids, role, connectors)) to (modelValue's components's values)
        return the string form of ""

# An instance: a component placed on its storey, in metres on the plan and
# turned `angle`, drawn in one view or in every plan of its storey, as the text
# parser reads an instance line.
local function add bim ifcx model instance {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set componentId to the bim ifcx model whole (the string form of "component") of record
        set levelId to the bim ifcx model whole (the string form of "level") of record
        set originX to the bim ifcx model number 0 of (the string form of "origin") in record
        set originY to the bim ifcx model number 1 of (the string form of "origin") in record
        set angle to the bim ifcx model real (the string form of "angle") of record
        set fieldsValid to ((id's valid and componentId's valid) and levelId's valid) and ((originX's valid and originY's valid) and angle's valid)
        if fieldsValid = false:
            return the string form of "malformed instance"
        if (bim ifcx model id id's value follows (modelValue's instances's values)) = false:
            return the string form of "instance ids out of order"
        # The view it is drawn in; a name that is not an id is no view, as the
        # line's eighth field is not.
        set viewId to the bim refused id
        set view to the bim ifcx model whole (the string form of "view") of record
        if view's valid:
            set viewId to view's value
        append (@intrinsic("construct", a bim instance record, id's value, componentId's value, levelId's value, (a cad vector2 with x originX's value and y originY's value), angle's value, viewId)) to (modelValue's instances's values)
        return the string form of ""

# A free mesh: its points, then each face as its corner count and corners, the
# arrays already counting them, as the text parser reads a mesh line. A face
# must fit the points it names.
local function add bim ifcx model mesh {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set levelId to the bim ifcx model whole (the string form of "level") of record
        set pointsEntry to the bim ifcx model member (the string form of "points") of record
        set facesEntry to the bim ifcx model member (the string form of "faces") of record
        set listed to false
        if (pointsEntry != (0 as a pointer to a JSON value)) and (facesEntry != (0 as a pointer to a JSON value)):
            set listed to ((the kind of pointsEntry) = the JSON array kind) and ((the kind of facesEntry) = the JSON array kind)
        if ((id's valid and levelId's valid) and listed) = false:
            return the string form of "malformed mesh"
        set pointCount to the length of pointsEntry
        set entryCount to the length of facesEntry
        if ((pointCount < 3) or (pointCount > 1000000)) or ((entryCount < 4) or (entryCount > 10000000)):
            return the string form of "a mesh needs points and faces"
        if (bim ifcx model id id's value follows (modelValue's meshes's values)) = false:
            return the string form of "mesh ids out of order"
        set points to a cad topology list of a cad vector3
        if (add bim ifcx model mesh points of pointsEntry to (the address of points)) = false:
            return the string form of "malformed mesh point"
        set faces to a cad topology list of an integer
        if (add bim ifcx model faces of facesEntry to (the address of faces)) = false:
            return the string form of "malformed mesh face"
        if (bim mesh faces (faces's values) fit pointCount) = false:
            return the string form of "a mesh face refers to a missing point"
        append (@intrinsic("construct", a bim mesh record, id's value, levelId's value, points, faces)) to (modelValue's meshes's values)
        return the string form of ""

# A linear type: the role and the profile its elements share, as a lineartype
# line writes them. The line writes its material's spaces as underscores.
local function add bim ifcx model linear type {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set role to the bim ifcx model whole (the string form of "role") of record
        set width to the bim ifcx model real (the string form of "width") of record
        set depth to the bim ifcx model real (the string form of "depth") of record
        set round to bim ifcx model flag (the string form of "round") of record
        if ((((id's valid and role's valid) and width's valid) and depth's valid) and round's valid) = false:
            return the string form of "malformed lineartype"
        if (bim ifcx model id id's value follows (modelValue's linearTypes's values)) = false:
            return the string form of "lineartype ids out of order"
        set roleCode to role's value as an integer
        if ((width's value <= 0.0) or (depth's value <= 0.0)) or ((roleCode < 0) or (roleCode > bim pile role)):
            return the string form of "a linear type needs a role and a profile"
        set material to (the bim ifcx model text (the string form of "material") of record) with "_" replaced by " "
        append (@intrinsic("construct", a bim linear type record, id's value, (the bim ifcx model text (the string form of "name") of record), roleCode, width's value, depth's value, round's value = (1 as a 64 bit integer), material)) to (modelValue's linearTypes's values)
        return the string form of ""

# A linear element: its axis, the angle its profile is turned about it, and the
# twist and taper of its finish, which a line writes together or not at all.
local function add bim ifcx model linear {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set typeId to the bim ifcx model whole (the string form of "type") of record
        set levelId to the bim ifcx model whole (the string form of "level") of record
        set start to the bim ifcx model point (the string form of "start") of record
        set finish to the bim ifcx model point (the string form of "finish") of record
        set angle to the bim ifcx model real (the string form of "angle") of record
        set endsValid to (start's valid and finish's valid) and angle's valid
        if ((id's valid and typeId's valid) and levelId's valid) and endsValid = false:
            return the string form of "malformed linear"
        if (bim ifcx model id id's value follows (modelValue's linears's values)) = false:
            return the string form of "linear ids out of order"
        if (the cad length of (the cad difference of finish's point and start's point)) < 0.001:
            return the string form of "a linear element needs an axis"
        set twistValue to 0.0
        set taperValue to a cad vector2 with x 1.0 and y 1.0
        set twist to the bim ifcx model real (the string form of "twist") of record
        set taperX to the bim ifcx model number 0 of (the string form of "taper") in record
        set taperY to the bim ifcx model number 1 of (the string form of "taper") in record
        if (twist's valid and taperX's valid) and taperY's valid:
            set twistValue to twist's value
            set taperValue to a cad vector2 with x taperX's value and y taperY's value
        append (@intrinsic("construct", a bim linear record, id's value, typeId's value, levelId's value, start's point, finish's point, angle's value, twistValue, taperValue)) to (modelValue's linears's values)
        return the string form of ""

# A space: its storey, height, outline and name, and then its number, which
# the text parser reads from a `spacenumber` line of its own. The refusals are
# the text parser's, in its order: the fields, the corners it is drawn with, the
# id, the height, the outline and the name.
local function add bim ifcx model space object {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set levelId to the bim ifcx model whole (the string form of "level") of record
        set height to the bim ifcx model real (the string form of "height") of record
        if ((id's valid and levelId's valid) and height's valid) = false:
            return the string form of "malformed space"
        set outlineEntry to the bim ifcx model member (the string form of "outline") of record
        set cornersListed to false
        if outlineEntry != (0 as a pointer to a JSON value):
            set cornersListed to (the kind of outlineEntry) = the JSON array kind
        if cornersListed = false:
            return the string form of "malformed space"
        if (the length of outlineEntry) < 3:
            return the string form of "a space needs at least 3 corners"
        if (bim ifcx model id id's value follows (modelValue's spaceObjects's values)) = false:
            return the string form of "space ids out of order"
        if height's value <= 0.0:
            return the string form of "a space needs a positive height"
        set outline to a cad topology list of a cad vector2
        set outlineFault to the bim ifcx model outline of record named (the string form of "space") into (the address of outline)
        if (the length of outlineFault) > 0:
            return outlineFault
        set name to the bim ifcx model text (the string form of "name") of record
        if (the length of name) = 0:
            return the string form of "a space needs a name"
        append (@intrinsic("construct", a bim space object record, id's value, levelId's value, name, (the bim ifcx model text (the string form of "number") of record), outline, height's value)) to (modelValue's spaceObjects's values)
        return the string form of ""

# A tag: an annotation of an element, centred at its place. The refusals are
# the text parser's: the fields, the id, and the element it names.
local function add bim ifcx model tag {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set elementId to the bim ifcx model whole (the string form of "element") of record
        set across to the bim ifcx model number 0 of (the string form of "place") in record
        set upward to the bim ifcx model number 1 of (the string form of "place") in record
        if (((id's valid and elementId's valid) and across's valid) and upward's valid) = false:
            return the string form of "malformed tag"
        if (bim ifcx model id id's value follows (modelValue's tags's values)) = false:
            return the string form of "tag ids out of order"
        if (bim element elementId's value can be tagged in (@intrinsic("dereference", modelValue))) = false:
            return the string form of "a tag refers to a missing element"
        append (@intrinsic("construct", a bim tag record, id's value, elementId's value, (a cad vector2 with x across's value and y upward's value))) to (modelValue's tags's values)
        return the string form of ""

# A view: documentation kept with the model. A view line carries its kind, its
# storey, cut, scale and crop and the categories it shows; its drawing type,
# display mode and depth follow on lines of their own. The record carries all
# of them, so the text parser's refusals are kept, in its order: the fields,
# the id and the kind.
local function add bim ifcx model view {a pointer to a JSON value:record} into {a pointer to a bim model record:modelValue}:
    execute:
        set id to the bim ifcx model whole (the string form of "id") of record
        set kind to the bim ifcx model whole (the string form of "kind") of record
        set levelId to the bim ifcx model whole (the string form of "level") of record
        set detail to the bim ifcx model whole (the string form of "detail") of record
        set cut to the bim ifcx model real (the string form of "cut") of record
        set scale to the bim ifcx model whole (the string form of "scale") of record
        set cropped to bim ifcx model flag (the string form of "cropped") of record
        set lowX to the bim ifcx model number 0 of (the string form of "low") in record
        set lowY to the bim ifcx model number 1 of (the string form of "low") in record
        set highX to the bim ifcx model number 0 of (the string form of "high") in record
        set highY to the bim ifcx model number 1 of (the string form of "high") in record
        set fromX to the bim ifcx model number 0 of (the string form of "from") in record
        set fromY to the bim ifcx model number 1 of (the string form of "from") in record
        set toX to the bim ifcx model number 0 of (the string form of "to") in record
        set toY to the bim ifcx model number 1 of (the string form of "to") in record
        set shownListed to record has JSON member named (the string form of "shown")
        set faintListed to record has JSON member named (the string form of "halftone")
        set nameListed to record has JSON member named (the string form of "name")
        set cornersValid to ((lowX's valid and lowY's valid) and (highX's valid and highY's valid)) and ((fromX's valid and fromY's valid) and (toX's valid and toY's valid))
        set fieldsValid to (((((id's valid and kind's valid) and levelId's valid) and detail's valid) and cut's valid) and scale's valid) and (cropped's valid and cornersValid)
        if ((fieldsValid and shownListed) and faintListed) and nameListed = false:
            return the string form of "malformed view"
        if (bim ifcx model id id's value follows (modelValue's views's values)) = false:
            return the string form of "view ids out of order"
        set kindCode to kind's value as an integer
        if (kindCode < 0) or (kindCode > 4):
            return the string form of "unknown view kind"
        set shownText to the bim ifcx model text (the string form of "shown") of record
        set faintText to the bim ifcx model text (the string form of "halftone") of record
        set shownFlags to a cad topology list of a boolean
        set faintFlags to a cad topology list of a boolean
        loop flagCursor from 0 to the length of shownText:
            append ((the character at flagCursor in shownText) = 49) to (shownFlags's values)
        loop flagCursor from 0 to the length of faintText:
            append ((the character at flagCursor in faintText) = 49) to (faintFlags's values)
        # The drawing type and phase a view follows, and how it is drawn. A
        # view line writes none of them; the record holds whatever it carries.
        set drawingTypeId to the bim refused id
        set automatic to false
        set phaseId to the bim refused id
        set drawingType to the bim ifcx model whole (the string form of "drawingType") of record
        if drawingType's valid:
            set drawingTypeId to drawingType's value
            set automaticReading to bim ifcx model flag (the string form of "automatic") of record
            if automaticReading's valid:
                set automatic to automaticReading's value = (1 as a 64 bit integer)
            set phase to the bim ifcx model whole (the string form of "phase") of record
            if phase's valid:
                set phaseId to phase's value
        set displayMode to 0
        set display to the bim ifcx model whole (the string form of "display") of record
        if display's valid:
            set displayMode to display's value as an integer
        set depth to 0.0
        set depthReading to the bim ifcx model real (the string form of "depth") of record
        if depthReading's valid:
            set depth to depthReading's value
        set lowCorner to a cad vector2 with x lowX's value and y lowY's value
        set highCorner to a cad vector2 with x highX's value and y highY's value
        set lineFrom to a cad vector2 with x fromX's value and y fromY's value
        set lineTo to a cad vector2 with x toX's value and y toY's value
        append (@intrinsic("construct", a bim view definition record, id's value, kindCode, (the bim ifcx model text (the string form of "name") of record), levelId's value, detail's value, cut's value, scale's value as an integer, cropped's value = (1 as a 64 bit integer), lowCorner, highCorner, shownFlags, faintFlags, lineFrom, lineTo, drawingTypeId, automatic, phaseId, displayMode, depth)) to (modelValue's views's values)
        return the string form of ""

# ---------------------------------------------------------------- the document

# The model in the IfcX document `content` (JSON text or its binary encoding),
# or a refusal naming the fault.
function the bim ifcx model of {a string:content}:
    execute:
        set parsed to the JSON document parsed from content
        if parsed failed:
            return a bim ifcx model refusal saying ((the string form of "not IfcX at byte ") + (the string form of (the JSON error position in parsed)))
        set document to the value of parsed
        set dataFound to false
        if (the kind of document) = the JSON object kind:
            set dataFound to document has JSON member named "data"
        if dataFound = false:
            free parsed
            return a bim ifcx model refusal saying (the string form of "not an IfcX file")
        set data to the JSON member named "data" in document
        set modelValue to an empty bim model
        set openbimPrefix to the string form of "openbim::"
        set fault to the string form of ""
        # Tags name the elements they annotate, and the writer puts them before
        # the wall types; they are built once every other record is in, as the
        # text parser reads them last.
        set pendingTags to an empty list of a pointer to a JSON value
        loop cursor from 0 to the length of data:
            set node to the JSON value at index cursor in data
            set attributesFound to false
            if (the kind of node) = the JSON object kind:
                set attributesFound to node has JSON member named "attributes"
            if attributesFound:
                set group to the JSON member named "attributes" in node
                if (the kind of group) = the JSON object kind:
                    loop member from 0 to the length of group:
                        if (the length of fault) = 0:
                            set entry to the item at member in (group's members)
                            set record to entry's value
                            if entry's name = (the string form of "openbim::project"):
                                set nextReading to the bim ifcx model whole (the string form of "next") of record
                                if nextReading's valid:
                                    set modelValue's nextId to nextReading's value
                            else if entry's name = (the string form of "openbim::level"):
                                set fault to (add bim ifcx model level record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::walltype"):
                                set fault to (add bim ifcx model wall type record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::wall"):
                                set fault to (add bim ifcx model wall record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::openingtype"):
                                set fault to (add bim ifcx model opening type record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::opening"):
                                set fault to (add bim ifcx model opening record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::slab"):
                                set fault to (add bim ifcx model slab record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::grid"):
                                set fault to (add bim ifcx model grid record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::dimension"):
                                set fault to (add bim ifcx model dimension record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::sketch"):
                                set fault to (add bim ifcx model element sketch record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::component"):
                                set fault to (add bim ifcx model component record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::instance"):
                                set fault to (add bim ifcx model instance record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::mesh"):
                                set fault to (add bim ifcx model mesh record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::lineartype"):
                                set fault to (add bim ifcx model linear type record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::linear"):
                                set fault to (add bim ifcx model linear record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::spaceObject"):
                                set fault to (add bim ifcx model space object record into (the address of modelValue))
                            else if entry's name = (the string form of "openbim::tag"):
                                append record to pendingTags
                            else if entry's name = (the string form of "openbim::view"):
                                set fault to (add bim ifcx model view record into (the address of modelValue))
                            else if (the length of entry's name) > (the length of openbimPrefix):
                                if (the substring of entry's name from 0 spanning (the length of openbimPrefix) bytes) = openbimPrefix:
                                    set fault to ((the string form of "not built yet: ") + entry's name)
        loop cursor from 0 to the length of pendingTags:
            if (the length of fault) = 0:
                set fault to (add bim ifcx model tag (the item at cursor in pendingTags) into (the address of modelValue))
        free pendingTags
        free parsed
        if (the length of fault) > 0:
            return a bim ifcx model refusal saying fault
        set problem to the bim reference fault of modelValue
        if (the length of problem) > 0:
            return a bim ifcx model refusal saying problem
        # Type names follow the naming rules, whatever a document says.
        name bim types by the rules in (the address of modelValue)
        return @intrinsic("construct", a bim ifcx model result record, true, modelValue, the string form of "")
